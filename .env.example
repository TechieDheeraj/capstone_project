# Copy to .env (never commit .env). Every variable has a safe default.

# offline | claude | local     (default: claude if ANTHROPIC_API_KEY is set, else offline)
MODEL_MODE=offline
ANTHROPIC_API_KEY=

# Routing: the small model for easy tickets, the large model for hard ones.
SMALL_MODEL=claude-haiku-4-5
LARGE_MODEL=claude-opus-5-5
LARGE_THINKING=adaptive

# A local OpenAI-compatible server (llama.cpp, Ollama, vLLM) for MODEL_MODE=local or FALLBACK=local.
LOCAL_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_MODEL=qwen3-4b
FALLBACK=none

# Budgets for one run (one ticket).
MAX_STEPS=12
MAX_TOKENS=120000
MAX_SECONDS=180
MAX_COST_USD=0.50

PROMPT_VERSION=v3
TOOLS_VIA=local
DEMO_MODE=0
